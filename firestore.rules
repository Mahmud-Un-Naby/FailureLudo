rules_version = '2';

// FailureLudo — online multiplayer rules.
// Authoritative collections are server-written and member-readable. Legacy preview
// rooms are closed to clients; deploy this change together with the migrated app.
service cloud.firestore {
  match /databases/{database}/documents {

    // Server-controlled rooms: members can observe snapshots; only the backend writes.
    match /authoritativeRooms/{roomCode} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberUids;
      allow write: if false;
    }
    match /authoritativeRequests/{requestKey} {
      allow read, write: if false;
    }

    // Player profiles: anyone signed in can read (to show names/avatars);
    // only the owner may write their own profile.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Retained legacy data is inaccessible to clients after the coordinated migration.
    match /rooms/{document=**} {
      allow read, write: if false;
    }
  }
}
