rules_version = '2';

// FailureLudo — online multiplayer rules.
// New authoritative collections are server-written and member-readable. The legacy
// client-written preview collections below remain until Android migration; they
// are not the authorization model for the server-controlled release.
service cloud.firestore {
  match /databases/{database}/documents {

    // Server-controlled rooms: members can observe snapshots; only the backend writes.
    match /authoritativeRooms/{roomCode} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberUids;
      allow write: if false;
    }
    match /authoritativeRequests/{requestKey} {
      allow read, write: if false;
    }

    // Player profiles: anyone signed in can read (to show names/avatars);
    // only the owner may write their own profile.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Game rooms + their move log. Any signed-in user (including anonymous
    // guests and spectators) may read; any signed-in user may create/join/play.
    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;

      match /moves/{moveId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null;
      }
    }
  }
}
